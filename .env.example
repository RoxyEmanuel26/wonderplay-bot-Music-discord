# Discord Bot Token
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here

# Database (PostgreSQL via Docker)
DATABASE_URL="postgresql://postgres:password@localhost:5432/aurelia?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Bot memakai daftar node Lavalink publik di src/config/lavalinkNodes.ts.
LAVALINK_RECONNECT_TRIES=12
LAVALINK_RECONNECT_INTERVAL_SECONDS=5
LAVALINK_RECONNECT_CYCLE_DELAY_MS=30000
LAVALINK_REST_TIMEOUT_SECONDS=12

# OAuth resmi bot untuk playlist/album Spotify yang dapat diakses akun tersebut.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# OAuth pengguna resmi untuk playlist/album milik akun atau kolaborasi akun tersebut.
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_PLAYLIST_MAX_TRACKS=500
SPOTIFY_MIRROR_CONCURRENCY=3

# Admin Settings (pisahkan dengan koma jika lebih dari satu)
OWNER_IDS=your_discord_id_here,another_id

# Bot Settings
DEFAULT_PREFIX=.
MUSIC_REQUEST_CHANNEL_ID=1343831026316742688
LYRICS_API_URL=https://lrclib.net
SPOTIFY_TRACK_FALLBACK_ENABLED=true
PLAYBACK_RECOVERY_ENABLED=true
PLAYBACK_CHECKPOINT_INTERVAL_MS=5000
# Biarkan true pada deployment. Test suite menonaktifkannya secara internal.
PLAYBACK_PERSISTENCE_ENABLED=true
